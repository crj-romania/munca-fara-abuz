EXPO_PUBLIC_CONTENT_BASE_URL=https://crj-romania.github.io/munca-fara-abuz
# Aptabase app key (EU region, starts with A-EU-). Empty = statistics disabled.
EXPO_PUBLIC_APTABASE_APP_KEY=
# Build environment: development | preview | production. Anything but production shows the TEST banner.
EXPO_PUBLIC_APP_ENV=development
# Feedback link for testers (form or WhatsApp group, https only). Shown only in test builds.
EXPO_PUBLIC_FEEDBACK_URL=
