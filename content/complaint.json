      "labelKey": "complaint.q.employment",
      "options": ["working", "stopped", "not_started", "unknown"]
    }
  },
  "commonFields": [
    { "id": "lastName", "type": "text", "required": true, "labelKey": "complaint.f.lastName", "hintKey": "complaint.f.lastName.hint" },
    {
      "id": "singleName",
      "type": "select",
      "required": true,
      "labelKey": "complaint.f.singleName",
      "options": [
        { "value": "yes", "labelKey": "complaint.f.singleName.yes" },
        { "value": "no", "labelKey": "complaint.f.singleName.no" }
      ]
    },
    {
      "id": "firstName",
      "type": "text",
      "required": false,
      "labelKey": "complaint.f.firstName",
      "visibleWhen": { "field": "singleName", "values": ["no"] },
      "requiredWhen": { "field": "singleName", "values": ["no"] }
    },
    { "id": "citizenship", "type": "text", "required": true, "labelKey": "complaint.f.citizenship" },
    {
      "id": "idType",
      "type": "select",
      "required": true,
      "labelKey": "complaint.f.idType",
      "options": [
        { "value": "passport", "labelKey": "complaint.f.idType.passport" },
        { "value": "trc", "labelKey": "complaint.f.idType.trc" }
      ]
    },
    { "id": "idNumber", "type": "text", "required": true, "labelKey": "complaint.f.idNumber" },
    {
      "id": "cnp",
      "type": "text",
      "required": false,
      "labelKey": "complaint.f.cnp",
      "hintKey": "complaint.f.cnp.hint",
      "requiredWhen": { "field": "idType", "values": ["trc"] },
      "validation": "cnp"
    },
    { "id": "address", "type": "text", "required": true, "labelKey": "complaint.f.address" },
    { "id": "addressCounty", "type": "county", "required": true, "labelKey": "complaint.f.addressCounty" },
    {
      "id": "phone",
      "type": "text",
      "required": false,
      "labelKey": "complaint.f.phone",
      "hintKey": "complaint.f.contact.hint",
      "requiredAnyOf": ["phone", "email"],
      "validation": "phone"
    },
    {
      "id": "email",
      "type": "text",
      "required": false,
      "labelKey": "complaint.f.email",
      "hintKey": "complaint.f.contact.hint",
      "requiredAnyOf": ["phone", "email"],
      "validation": "email"
    }
