{
  "expo": {
    "name": "Muncă Fără Abuz",
    "slug": "munca-fara-abuz",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "muncafaraabuz",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ro.crj.muncafaraabuz"
    },
    "android": {
      "package": "ro.crj.muncafaraabuz",
      "allowBackup": false
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-mail-composer",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app lets you attach photos of your documents to a complaint.",
          "cameraPermission": "The app lets you photograph your documents to attach them to a complaint.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ]
          }
        }
      ],
      "expo-sharing",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0400f74d-46fe-4c7e-bdc5-fc08d9598229"
      }
    },
    "owner": "crj-romania"
  }
}
