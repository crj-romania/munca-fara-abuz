{
  "name": "munca-fara-abuz",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --go",
    "start:dev-client": "expo start --dev-client",
    "android": "expo start --go --android",
    "ios": "expo start --go --ios",
    "typecheck": "tsc --noEmit",
    "check:content": "node scripts/check-content.mjs",
    "check:phase1": "npm run typecheck && npm run check:content",
    "check:phase2": "npm run check:phase1 && node scripts/check-phase2.mjs",
    "check:phase3": "npm run check:phase2 && node scripts/check-phase3.mjs && node scripts/check-complaint-flow.mjs",
    "check:phase4": "npm run check:phase3 && node scripts/check-phase4.mjs && node scripts/check-translation-engine.mjs && node scripts/check-attachments.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans": "0.4.2",
    "@expo-google-fonts/noto-sans-arabic": "0.4.3",
    "@expo-google-fonts/noto-sans-bengali": "0.4.4",
    "@expo-google-fonts/noto-sans-devanagari": "0.4.1",
    "@expo-google-fonts/noto-sans-sinhala": "0.4.2",
    "@expo-google-fonts/noto-sans-tamil": "0.4.2",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.37",
    "expo-asset": "~12.0.13",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.11",
    "expo-intent-launcher": "~13.0.8",
    "expo-linking": "~8.0.11",
    "expo-mail-composer": "~15.0.8",
    "expo-modules-core": "~3.0.30",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.23",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "i18next": "^25.7.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^16.4.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.12",
    "typescript": "~5.9.2"
  }
