{
  "name": "munca-fara-abuz",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --go",
    "start:dev-client": "expo start --dev-client",
    "android": "expo start --go --android",
    "ios": "expo start --go --ios",
    "typecheck": "tsc --noEmit",
    "check:content": "node scripts/check-content.mjs",
    "check:phase1": "npm run typecheck && npm run check:content",
    "check:phase2": "npm run check:phase1 && node scripts/check-phase2.mjs",
    "check:phase3": "npm run check:phase2 && node scripts/check-phase3.mjs && node scripts/check-complaint-flow.mjs",
    "check:phase4": "npm run check:phase3 && node scripts/check-phase4.mjs && node scripts/check-translation-engine.mjs && node scripts/check-attachments.mjs && npm run check:translations",
    "check:translations": "node scripts/check-translations.mjs"
  },
  "dependencies": {
    "@aptabase/react-native": "0.6.0",
    "@expo-google-fonts/noto-sans": "0.4.2",
    "@expo-google-fonts/noto-sans-arabic": "0.4.3",
    "@expo-google-fonts/noto-sans-bengali": "0.4.4",
    "@expo-google-fonts/noto-sans-devanagari": "0.4.1",
    "@expo-google-fonts/noto-sans-sinhala": "0.4.2",
    "@expo-google-fonts/noto-sans-tamil": "0.4.2",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^57.0.27",
    "expo-asset": "~57.0.19",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-intent-launcher": "~57.0.1",
    "expo-linking": "~57.0.12",
    "expo-mail-composer": "~57.0.2",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.25",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "i18next": "^25.7.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^16.4.0",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "babel-preset-expo": "~57.0.14",
    "typescript": "~5.9.2"
  }
}
